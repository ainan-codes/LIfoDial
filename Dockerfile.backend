# Dockerfile.backend — Production image for Render.com (and any Linux host)
#
# Includes:
#   - ffmpeg (required for audio format conversion in WebSocket voice pipeline)
#   - libpq-dev (required for asyncpg PostgreSQL driver)
#   - curl (required for HEALTHCHECK)

FROM python:3.11-slim

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ ./backend/

# Create uploads directory (writable at runtime)
RUN mkdir -p uploads && chmod 777 uploads

# Health check — Render pings /health
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-10000}/health || exit 1

# Render injects $PORT at runtime (default 10000).
# Use shell form so the variable is expanded at container start.
#
# `alembic upgrade head` runs real migrations from backend/alembic/versions —
# until now, deploy never ran this at all: init_db()'s create_all(checkfirst=True)
# was the only schema sync, and checkfirst only creates missing TABLES, never
# alters an existing one, so a migration that adds/changes a column on an
# existing table would silently never reach production. Verified before wiring
# this in: prod's alembic_version was already stamped at the migration chain's
# head (a1b2c3d4e5f6), so this is a no-op today and only starts mattering the
# next time someone adds a migration.
#
# Best-effort, matching init_db()'s own philosophy (see backend/db.py) of never
# letting a schema-sync hiccup block boot: `|| true` means a transient DB
# connection failure here logs and falls through to start the app rather than
# crash-looping the whole service. `exec` replaces the shell with uvicorn so it
# becomes PID 1 and receives Render's SIGTERM directly for a clean shutdown.
CMD (cd backend && PYTHONPATH=/app python -m alembic upgrade head || echo "[WARN] alembic upgrade head failed — continuing on the existing schema") && \
    exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1
